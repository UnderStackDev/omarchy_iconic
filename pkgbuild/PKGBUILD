pkgname=iconic
pkgver=0.1.0
pkgrel=1
pkgdesc='Icon themes and app launchers for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal' 'glib2' 'gtk-update-icon-cache' 'desktop-file-utils')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/iconic "$pkgdir/usr/bin/iconic"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/iconic.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/iconic.svg"
  install -Dm644 "$startdir/iconic.desktop" "$pkgdir/usr/share/applications/iconic.desktop"
}
